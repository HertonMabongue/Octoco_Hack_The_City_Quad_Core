# ─────────────────────────────────────────────────────────────────────────
# ONE env file for the whole stack. Copy to .env and edit — nothing else.
#   backend   reads it directly
#   frontend  loads it via frontend/next.config.js (local dev)
#   firmware  loads it via firmware/load_env.py at PlatformIO build time
# ─────────────────────────────────────────────────────────────────────────

#ngrok
# Local-only testing: http://127.0.0.1:8000 for the frontend (not `localhost`:
# the backend is IPv4-only and Node may resolve localhost to ::1); for the ESP32
# use this machine's LAN address, e.g. http://192.168.1.50:8000.
PUBLIC_API_URL=http://127.0.0.1:8000

# Wifi the ESP32 joins (2.4 GHz only — the ESP32 can't see 5 GHz networks).
# Wrap a value in double quotes if it contains spaces: WIFI_SSID="My Wifi"
WIFI_SSID=
WIFI_PASSWORD=

# Which bin this firmware build is. Must exist in DEVICE_REGISTRY
# (backend/app/config.py): bin-01, bin-02, bin-03.
DEVICE_SLUG=bin-01

# Vercel: set PUBLIC_API_URL there too (Project → Settings → Environment
# Variables) and redeploy — Vercel can't see this file.

# City mainframe (Hack the City protocol) ───────────────────────────
TEAM_ID=kmm4v
BROKER_HOST=192.168.101.123
BROKER_PORT=1883
BROKER_USERNAME=
BROKER_PASSWORD=

# HTTP fallback endpoint on the city mainframe, used if MQTT is unreachable
CITY_HTTP_HOST=192.168.101.123
CITY_HTTP_PORT=8000

# ── 3. Thresholds (shared by backend and firmware) ───────────────────────
FILL_WARNING_PCT=60
FILL_CRITICAL_PCT=85
GAS_ALERT_RAW=800

# ── 4. Demo data ─────────────────────────────────────────────────────────
# Fake readings for bins with no hardware. A bin with real firmware posting
# is skipped automatically, so there is nothing to switch off.
MOCK_TELEMETRY_ENABLED=true
MOCK_INTERVAL_S=30
# Made-up littering reports (labelled "[simulated]") so the hotspot map isn't
# empty before real reports arrive. Added once at startup if none exist.
SEED_DEMO_REPORTS=true
# Mark a device offline (locally + to the city) if silent this long
OFFLINE_AFTER_S=90

# ── 5. Browser origins allowed to call the API (comma-separated) ─────────
# Vercel preview deployments of streetwise-app are allowed automatically.
CORS_ORIGINS=https://streetwise-app.vercel.app,http://localhost:3000

# ── 6. Data retention (see docs/DATA_PROTECTION.md) ──────────────────────
PHOTO_RETENTION_RESOLVED_HOURS=24
PHOTO_RETENTION_OPEN_DAYS=30
REPORT_RETENTION_DAYS=365
READINGS_RETENTION_DAYS=90
ALERT_RETENTION_DAYS=365

# ── 7. Optional ──────────────────────────────────────────────────────────
# Municipal dashboard demo login (defaults: operator / corridor2026)
# MUNICIPAL_USERNAME=operator
# MUNICIPAL_PASSWORD=corridor2026
# Storage defaults to backend/data.sqlite3 and backend/uploads
# DB_PATH=
# UPLOAD_DIR=
