# Shared MQTT identity (must match firmware build flags)
TEAM_ID=kmm4v
DEVICE_SLUG=bin-01

# Backend service — city mainframe MQTT broker
BROKER_HOST=192.168.101.123
BROKER_PORT=1883
BROKER_USERNAME=
BROKER_PASSWORD=

# MUNICIPAL_USERNAME=operator
# MUNICIPAL_PASSWORD=corridor2026

# HTTP fallback endpoint on the city mainframe, used if MQTT is unreachable
CITY_HTTP_HOST=192.168.101.123
CITY_HTTP_PORT=8000

# Storage — leave unset to use the default (backend/data.sqlite3,
# backend/uploads, resolved from the backend/ dir itself regardless of
# where uvicorn is launched from). Only set these to use a different
# location.
# DB_PATH=
# UPLOAD_DIR=

# Bin fill-level thresholds (percent full)
FILL_WARNING_PCT=60
FILL_CRITICAL_PCT=85

# Mock telemetry — generates readings for every DEVICE_REGISTRY device so the
# backend is live on the city broker before firmware is posting. Set to
# false once firmware is posting to /api/devices/{id}/readings for real.
MOCK_TELEMETRY_ENABLED=true
MOCK_INTERVAL_S=30

# Mark a device offline (locally + to the city) if it hasn't reported in this long
OFFLINE_AFTER_S=90

# Frontend service
NEXT_PUBLIC_API_URL=http://localhost:8000
